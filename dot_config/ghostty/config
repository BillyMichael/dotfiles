# ~/.config/ghostty/config — managed by chezmoi. Reload with Cmd+Shift+, ; list options: ghostty +show-config --default
command = /bin/zsh

font-family = JetBrainsMono Nerd Font Mono
font-size = 13
font-thicken = true
adjust-cell-height = 10%

# follows macOS light/dark
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
background-opacity = 1.0

window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-paste-protection = true
shell-integration = zsh
shell-integration-features = cursor,sudo,title

scrollback-limit = 20000000

# splits like tmux-lite
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
