# ~/.Brewfile — managed by chezmoi (template: casks and mac-only formulae are omitted on Linux/WSL).
# Install everything with:  brew bundle --global
tap "derailed/k9s"
tap "hashicorp/tap"
tap "int128/kubelogin"
tap "robscott/tap"
tap "robusta-dev/krr"

# shell
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"
brew "chezmoi"
brew "jq"
brew "yq"
brew "gh"
brew "shellcheck"

# kubernetes / platform
brew "kubernetes-cli"
brew "helm"
brew "kind"
brew "k3d"
brew "argocd"
brew "kubeconform"
brew "kubescape"
brew "kyverno"
brew "hubble"
brew "derailed/k9s/k9s"
brew "int128/kubelogin/kubelogin"
brew "robscott/tap/kube-capacity"
brew "robusta-dev/krr/krr"
brew "hashicorp/tap/terraform"
brew "cloudformation-cli"

{{- if eq .chezmoi.os "darwin" }}
# containers (macOS: podman runs in a VM; on WSL use `sudo apt install podman` or Docker Desktop)
brew "podman"
brew "podman-compose"
{{- end }}

# security scanning
brew "trivy"
brew "gitleaks"
brew "trufflehog"

# languages / data
brew "go"
brew "nvm"      # node versions live in ~/.nvm; default version is put on PATH by .zprofile
brew "yarn"     # pulls in brew node as a dependency; nvm's default wins on PATH
brew "uv"
brew "postgresql@16"
brew "duckdb"
brew "poppler"
brew "typst"

{{- if eq .chezmoi.os "darwin" }}
# apps
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
cask "1password"        # desktop app: required for op biometric unlock
cask "1password-cli"
cask "visual-studio-code"
cask "warp"
cask "obsidian"
cask "slack"
cask "discord"
cask "todoist-app"
cask "grammarly"
cask "libreoffice"
cask "ngrok"
{{- end }}
