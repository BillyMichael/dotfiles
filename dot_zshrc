# ~/.zshrc — managed by chezmoi. Edit with `chezmoi edit ~/.zshrc`, then `chezmoi apply`.
# Startup order: .zprofile (brew shellenv, nvm) → .zshrc (this) → ~/.config/zsh/local.zsh (untracked)

# ---------- Homebrew (login shells already have this from .zprofile) ----------
[[ -z "$HOMEBREW_PREFIX" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ---------- History ----------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_SAVE_NO_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS

# ---------- Completion ----------
fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# Rebuild the completion cache at most once a day; otherwise trust it (fast start)
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------- Editor / paths ----------
export EDITOR=vim
export VISUAL=vim
export PATH="$HOME/.local/bin:$PATH"

# ---------- Prompt, navigation, fuzzy finding ----------
eval "$(starship init zsh)"          # prompt: ~/.config/starship.toml
eval "$(zoxide init zsh)"            # z <dir-fragment> to jump, zi for interactive picker
source <(fzf --zsh)                  # Ctrl-R history, Ctrl-T files, Alt-C directories
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'

# ---------- Plugins (installed by Homebrew, no framework) ----------
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
source "$HOMEBREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh"
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^P'   history-substring-search-up
bindkey '^N'   history-substring-search-down
# syntax highlighting must be sourced last of the plugins
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ---------- Modern replacements ----------
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lah --git --group-directories-first --icons=auto'
  alias la='eza -a --group-directories-first --icons=auto'
  alias l='eza -1 --group-directories-first'
  alias tree='eza --tree --level=3'
else
  alias ll='ls -lah' la='ls -A' l='ls -CF'
fi
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'

# ---------- General aliases ----------
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias mkdir='mkdir -pv'
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'

# ---------- Git ----------
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline -20'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gp='git push'
alias gpl='git pull'
alias gf='git fetch --all --prune'
alias gb='git branch'
alias gsw='git switch'

# ---------- Kubernetes ----------
alias k=kubectl
command -v kubectx >/dev/null && alias kctx=kubectx
command -v kubens  >/dev/null && alias kns=kubens
if command -v kubectl >/dev/null; then
  source <(kubectl completion zsh)
  compdef k=kubectl
fi

# ---------- Podman as Docker ----------
if command -v podman >/dev/null; then
  alias docker=podman
  alias docker-compose=podman-compose
  alias pcu='podman-compose up -d'
  alias pcd='podman-compose down'
  alias pcl='podman-compose logs -f'
  alias pcr='podman-compose restart'
  export DOCKER_HOST="unix://$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null)"
fi

# ---------- 1Password secrets → env ----------
source "$HOME/.config/zsh/functions/opsecrets.zsh"
opsecrets-load   # cached; refreshes in background when stale (opsecrets-refresh to force)

# ---------- Machine-local, untracked (secrets, client/project-specific exports) ----------
[[ -f "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
