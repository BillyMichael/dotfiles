# ~/.zshrc — managed by chezmoi. Edit with `chezmoi edit ~/.zshrc`, then `chezmoi apply`.
# Startup order: .zprofile (brew shellenv, nvm) → .zshrc (this) → ~/.config/zsh/local.zsh (untracked)

# ---------- Homebrew (login shells already have this from .zprofile) ----------
[[ -z "$HOMEBREW_PREFIX" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ---------- History ----------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_SAVE_NO_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
setopt EXTENDED_HISTORY        # timestamps in the history file (history -i to see them)
setopt HIST_IGNORE_SPACE       # a leading space keeps a command out of history
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS

# ---------- Completion ----------
ZSH_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$ZSH_CACHE/completions"
fpath=("$ZSH_CACHE/completions" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
# Generated completions are cached and only rebuilt when the binary changes
if command -v kubectl >/dev/null; then
  [[ "$ZSH_CACHE/completions/_kubectl" -nt "$(command -v kubectl)" ]] || kubectl completion zsh > "$ZSH_CACHE/completions/_kubectl"
fi
autoload -Uz compinit
# Rebuild the completion dump at most once a day; otherwise trust it (-C skips the security scan).
# compinit does not bump the dump's mtime when nothing changed, so touch it after a full run.
_zcd=( ~/.zcompdump(N.mh+24) )
if (( $#_zcd )) || [[ ! -f ~/.zcompdump ]]; then
  compinit -d ~/.zcompdump && touch ~/.zcompdump
else
  compinit -C -d ~/.zcompdump
fi
unset _zcd
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------- Keys (Home/End/Delete/PgUp/PgDn, Ctrl/Alt-Arrow word jumps) ----------
bindkey -e                                  # emacs keymap
bindkey '^[[H'    beginning-of-line         # Home
bindkey '^[[1~'   beginning-of-line
bindkey '^[[F'    end-of-line               # End
bindkey '^[[4~'   end-of-line
bindkey '^[[3~'   delete-char               # Delete
bindkey '^[[5~'   up-line-or-history        # PgUp
bindkey '^[[6~'   down-line-or-history      # PgDn
bindkey '^[[1;5C' forward-word              # Ctrl-Right
bindkey '^[[1;5D' backward-word             # Ctrl-Left
bindkey '^[[1;3C' forward-word              # Alt-Right
bindkey '^[[1;3D' backward-word             # Alt-Left
bindkey '^[^?'    backward-kill-word        # Alt-Backspace
bindkey '^[[Z'    reverse-menu-complete     # Shift-Tab

# ---------- Editor / paths ----------
export EDITOR=vim
export VISUAL=vim
export PATH="$HOME/.local/bin:$PATH"

# ---------- Prompt, navigation, fuzzy finding ----------
# Everything below is guarded so a fresh machine works before `brew bundle --global` has run.
command -v starship >/dev/null && eval "$(starship init zsh)"   # prompt: ~/.config/starship.toml
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"     # z <dir-fragment> to jump, zi = interactive
command -v fzf      >/dev/null && source <(fzf --zsh)           # Ctrl-R history, Ctrl-T files, Alt-C dirs
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'

# ---------- Plugins (installed by Homebrew, no framework) ----------
_plug="$HOMEBREW_PREFIX/share"
if [[ -r "$_plug/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$_plug/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi
if [[ -r "$_plug/zsh-history-substring-search/zsh-history-substring-search.zsh" ]]; then
  source "$_plug/zsh-history-substring-search/zsh-history-substring-search.zsh"
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey '^P'   history-substring-search-up
  bindkey '^N'   history-substring-search-down
fi
# syntax highlighting must be sourced last of the plugins
[[ -r "$_plug/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$_plug/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset _plug

# ---------- Functions (sourced before aliases so `rm -i` etc. are not baked into them) ----------
source "$HOME/.config/zsh/functions/opsecrets.zsh"

# ---------- Modern replacements ----------
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lah --git --group-directories-first --icons=auto'
  alias la='eza -a --group-directories-first --icons=auto'
  alias l='eza -1 --group-directories-first'
  alias tree='eza --tree --level=3'
else
  alias ll='ls -lah' la='ls -A' l='ls -CF'
fi
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'

# ---------- General aliases ----------
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias mkdir='mkdir -pv'
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'

# ---------- Git ----------
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline -20'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gp='git push'
alias gpl='git pull'
alias gf='git fetch --all --prune'
alias gb='git branch'
alias gsw='git switch'

# ---------- Kubernetes ----------
alias k=kubectl
command -v kubectx >/dev/null && alias kctx=kubectx
command -v kubens  >/dev/null && alias kns=kubens
command -v kubectl >/dev/null && compdef k=kubectl

# ---------- Podman as Docker ----------
if command -v podman >/dev/null; then
  alias docker=podman
  alias docker-compose=podman-compose
  alias pcu='podman-compose up -d'
  alias pcd='podman-compose down'
  alias pcl='podman-compose logs -f'
  alias pcr='podman-compose restart'
  # `podman machine inspect` costs ~30ms; cache the socket path until podman is upgraded
  if [[ ! -s "$ZSH_CACHE/podman-socket" || ! "$ZSH_CACHE/podman-socket" -nt "$(command -v podman)" ]]; then
    podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' > "$ZSH_CACHE/podman-socket" 2>/dev/null || : > "$ZSH_CACHE/podman-socket"
  fi
  [[ -s "$ZSH_CACHE/podman-socket" ]] && export DOCKER_HOST="unix://$(<"$ZSH_CACHE/podman-socket")"
fi

# ---------- nvm (lazy: default node is already on PATH via .zprofile) ----------
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
nvm() {
  unfunction nvm
  if   [[ -s "$NVM_DIR/nvm.sh" ]];                 then \. "$NVM_DIR/nvm.sh"                  # curl installer
  elif [[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]]; then \. "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"  # brew "nvm"
  else echo "nvm not installed (brew install nvm)"; return 127
  fi
  nvm "$@"
}

# ---------- 1Password secrets → env ----------
opsecrets-load   # cached; refreshes in background when stale (opsecrets-refresh to force)

# ---------- Machine-local, untracked (secrets, client/project-specific exports) ----------
[[ -f "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
