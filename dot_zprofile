# ~/.zprofile — login-shell environment. Managed by chezmoi. Works on macOS and Linux/WSL.

# Homebrew: Apple Silicon, Intel mac, or Linuxbrew — whichever exists
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x "$_brew" ]]; then eval "$("$_brew" shellenv)"; break; fi
done
unset _brew

# nvm is slow (~0.8s) to source, so we don't. Put the default node version on PATH
# directly; `nvm` itself is lazy-loaded on first use (see .zshrc).
export NVM_DIR="$HOME/.nvm"
if [[ -r "$NVM_DIR/alias/default" ]]; then
  _nvm_alias="$(<"$NVM_DIR/alias/default")"
  # follow alias chains such as default -> lts/* -> lts/jod -> v22.x (max 3 hops)
  for _i in 1 2 3; do
    [[ -r "$NVM_DIR/alias/$_nvm_alias" ]] || break
    _nvm_alias="$(<"$NVM_DIR/alias/$_nvm_alias")"
  done
  # highest matching version, sorted numerically (nOn), so v22.23 beats v22.9
  _nvm_default=( "$NVM_DIR"/versions/node/v${_nvm_alias#v}*(N/nOn[1]) )
  [[ -n "$_nvm_default" ]] && export PATH="$_nvm_default/bin:$PATH"
  unset _nvm_alias _nvm_default _i
fi
