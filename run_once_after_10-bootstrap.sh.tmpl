#!/bin/sh
# Runs once per machine after chezmoi has written the dotfiles. Installs Homebrew if absent
# and, only on a machine where it was just installed, runs `brew bundle --global`.
# On an existing machine it prints what to run instead, so `chezmoi apply` stays fast.
set -eu

{{ if eq .chezmoi.os "linux" -}}
# --- Linux / WSL (Ubuntu/Debian) ---
if command -v apt-get >/dev/null 2>&1; then
  # Repair third-party apt repos that otherwise spam warnings on every apt-get update.
  # HashiCorp rotates signing keys: refresh the keyring if the repo is configured.
  if [ -f /etc/apt/sources.list.d/hashicorp.list ]; then
    echo ">> apt: refreshing HashiCorp signing key"
    curl -fsSL https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor --yes -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
  fi
  # Docker: move from the legacy trusted.gpg keyring + wrong suite to a signed-by list for this release.
  for f in /etc/apt/sources.list.d/*docker*.list; do
    [ -f "$f" ] || continue
    grep -q 'signed-by=' "$f" && continue
    echo ">> apt: rewriting Docker repo ($f)"
    sudo install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
    . /etc/os-release
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
    [ "$f" != /etc/apt/sources.list.d/docker.list ] && sudo rm -f "$f"
  done
  echo ">> apt: zsh and Homebrew build prerequisites"
  sudo apt-get update -qq
  sudo apt-get install -y -qq zsh git curl build-essential procps file ca-certificates
fi
BREW=/home/linuxbrew/.linuxbrew/bin/brew
{{ else -}}
# --- macOS ---
if [ -x /opt/homebrew/bin/brew ]; then BREW=/opt/homebrew/bin/brew; else BREW=/usr/local/bin/brew; fi
{{ end -}}

fresh=0
if [ ! -x "$BREW" ]; then
  echo ">> Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fresh=1
fi
eval "$("$BREW" shellenv)"

if [ "$fresh" = 1 ] && [ -f "$HOME/.Brewfile" ]; then
  echo ">> brew bundle --global (first run on this machine)"
  brew bundle --global --no-upgrade || echo "!! some packages failed; re-run: brew bundle --global"
else
  echo ">> Homebrew already present. To install/refresh packages:  brew bundle --global"
fi

{{ if eq .chezmoi.os "linux" -}}
if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
  echo ">> Make zsh your login shell:  chsh -s \"\$(command -v zsh)\"   (then log out and back in)"
fi
cat <<'MSG'
>> WSL notes
   - 1Password: install the Windows app, enable Settings > Developer > "Integrate with 1Password CLI",
     then in WSL:  brew install 1password-cli   and follow https://developer.1password.com/docs/cli/get-started/#wsl
     Until op can unlock, the shell simply starts without the cached secrets.
   - Terminal: use Windows Terminal with a Nerd Font (e.g. JetBrainsMono Nerd Font) for prompt glyphs.
   - Machine-local exports/secrets go in ~/.config/zsh/local.zsh (untracked).
MSG
{{ end -}}
